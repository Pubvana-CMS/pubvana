<?xml version="1.0" encoding="UTF-8"?>
<softinstall xmlns="http://www.softaculous.com">
	<settings>
		<group>
			<heading>{{admin_account}}</heading>
			<input type="text" name="admin_username" size="30" value="admin">
				<head>{{admin_username}}</head>
				<exp>{{admin_username_exp}}</exp>
			</input>
			<input type="password" name="admin_pass" size="30" value="">
				<head>{{admin_pass}}</head>
				<exp>{{admin_pass_exp}}</exp>
			</input>
			<input type="text" name="admin_email" size="30" value="" softmail="true">
				<head>{{admin_email}}</head>
				<exp>{{admin_email_exp}}</exp>
			</input>
		</group>
	</settings>
	<db>mysql</db>
	<cron>
		<min>*/1</min>
		<hour>*</hour>
		<day>*</day>
		<month>*</month>
		<weekday>*</weekday>
		<command>/usr/local/bin/php -q [[softpath]]/cron 1m</command>
	</cron>
	<cron>
		<min>0</min>
		<hour>*/4</hour>
		<day>*</day>
		<month>*</month>
		<weekday>*</weekday>
		<command>/usr/local/bin/php -q [[softpath]]/cron 4h</command>
	</cron>
	<cron>
		<min>0</min>
		<hour>0</hour>
		<day>*</day>
		<month>*</month>
		<weekday>*</weekday>
		<command>/usr/local/bin/php -q [[softpath]]/cron 24h</command>
	</cron>
</softinstall>
