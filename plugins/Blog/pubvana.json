{
    "name": "pubvana/blog",
    "display_name": "Blog",
    "description": "Blog module for Pubvana CMS",
    "type": "plugin",
    "pubver_min": "3.0.0",
    "pubver_max": "",
    "category": "content",
    "semver": "0.3.9",
    "provides": {
        "admin.menu": {
            "content": {
                "blog": {
                    "label": "Blog",
                    "url": "/blog",
                    "icon": "ti-article",
                    "priority": 10,
                    "permission": "posts.create",
                    "submenu": {
                        "posts": {
                            "label": "Posts",
                            "url": "/blog",
                            "priority": 10,
                            "permission": "posts.create"
                        },
                        "categories": {
                            "label": "Categories",
                            "url": "/blog/categories",
                            "priority": 20,
                            "permission": "categories.manage"
                        },
                        "tags": {
                            "label": "Tags",
                            "url": "/blog/tags",
                            "priority": 30,
                            "permission": "tags.manage"
                        }
                    }
                }
            }
        },
        "admin.dashboard": {
            "cards": {},
            "sections": {}
        }
    }
}
