{
    "name": "Text Block",
    "slug": "text_block",
    "description": "Displays custom HTML or text content.",
    "version": "2.0.0",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.2.3",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "author": "Pubvana Team",
    "admin": {
        "options": {
            "title": {
                "type": "text",
                "label": "Widget Title",
                "default": ""
            },
            "content": {
                "type": "textarea",
                "label": "Content",
                "default": ""
            }
        }
    },
    "output": {
        "template": "widget.tpl"
    }
}
