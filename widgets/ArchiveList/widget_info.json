{
    "name": "Archive List",
    "slug": "archive_list",
    "description": "Displays a list of monthly or yearly archive links.",
    "version": "2.0.0",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.2.4",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "author": "Pubvana Team",
    "admin": {
        "options": {
            "title": {
                "type": "text",
                "label": "Widget Title",
                "default": "Archives"
            },
            "format": {
                "type": "select",
                "label": "Format",
                "default": "monthly",
                "choices": {
                    "monthly": "Monthly",
                    "yearly": "Yearly"
                }
            }
        }
    },
    "output": {
        "template": "widget.tpl",
        "providers": {
            "rows": {
                "provider": "PostModel.getArchiveList",
                "params": {
                    "format": "format"
                }
            }
        }
    }
}
