{
    "name": "Archive List",
    "bundled": true,
    "free": false,
    "description": "Displays a list of monthly or yearly archive links.",
    "version": "2.0.5",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.3.5",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "items_url": "",
    "item_url": "",
    "categories_url": "",
    "categories_all_url": "",
    "category_url": "",
    "featured_url": "",
    "license_validate_url": "",
    "license_check_url": "",
    "update_check_url": "",
    "download_url": "",
    "store_url": "",
    "author": "Pubvana Team",
    "author_url": "https://pubvana.net",
    "admin": {
        "options": {
            "title": {
                "type": "text",
                "label": "Widget Title",
                "default": "Archives"
            },
            "format": {
                "type": "select",
                "label": "Format",
                "default": "monthly",
                "choices": {
                    "monthly": "Monthly",
                    "yearly": "Yearly"
                }
            }
        }
    },
    "output": {
        "template": "widget.tpl",
        "providers": {
            "rows": {
                "provider": "PostModel.getArchiveList",
                "params": {
                    "format": "format"
                }
            }
        }
    }
}