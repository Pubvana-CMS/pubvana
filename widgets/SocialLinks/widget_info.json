{
    "name": "Social Links",
    "bundled": true,
    "free": false,
    "description": "Displays social media profile links.",
    "version": "2.0.6",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.3.5",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "items_url": "",
    "item_url": "",
    "categories_url": "",
    "categories_all_url": "",
    "category_url": "",
    "featured_url": "",
    "license_validate_url": "",
    "license_check_url": "",
    "update_check_url": "",
    "download_url": "",
    "store_url": "",
    "author": "Pubvana Team",
    "author_url": "https://pubvana.net",
    "admin": {
        "notice": "Social links are managed centrally. To add or edit your social profiles, go to Admin \u2192 Social Links.",
        "options": {
            "title": {
                "type": "text",
                "label": "Widget Title",
                "default": "Follow Us"
            },
            "style": {
                "type": "select",
                "label": "Style",
                "default": "icons",
                "choices": {
                    "icons": "Icons only",
                    "icons+text": "Icons + Text"
                }
            }
        }
    },
    "output": {
        "template": "widget.tpl",
        "providers": {
            "links": {
                "provider": "SocialModel.getActive",
                "params": {}
            }
        }
    }
}