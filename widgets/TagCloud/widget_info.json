{
    "name": "Tag Cloud",
    "bundled": true,
    "free": false,
    "description": "Displays tags as a cloud of links.",
    "version": "2.0.6",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.3.5",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "items_url": "",
    "item_url": "",
    "categories_url": "",
    "categories_all_url": "",
    "category_url": "",
    "featured_url": "",
    "license_validate_url": "",
    "license_check_url": "",
    "update_check_url": "",
    "download_url": "",
    "store_url": "",
    "author": "Pubvana Team",
    "author_url": "https://pubvana.net",
    "admin": {
        "options": {
            "title": {
                "type": "text",
                "label": "Widget Title",
                "default": "Tags"
            },
            "max_tags": {
                "type": "number",
                "label": "Maximum Tags",
                "default": "30"
            }
        }
    },
    "output": {
        "template": "widget.tpl",
        "providers": {
            "tags": {
                "provider": "TagModel.getWithPostCount",
                "params": {
                    "limit": "max_tags"
                }
            }
        }
    }
}