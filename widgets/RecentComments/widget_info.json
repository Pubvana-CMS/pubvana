{
    "name": "Recent Comments",
    "bundled": true,
    "free": false,
    "description": "Displays the most recent approved comments.",
    "version": "2.0.6",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.3.6",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "items_url": "",
    "item_url": "",
    "categories_url": "",
    "categories_all_url": "",
    "category_url": "",
    "featured_url": "",
    "license_validate_url": "",
    "license_check_url": "",
    "update_check_url": "",
    "download_url": "",
    "store_url": "",
    "author": "Pubvana Team",
    "author_url": "https://pubvana.net",
    "admin": {
        "options": {
            "title": {
                "type": "text",
                "label": "Widget Title",
                "default": "Recent Comments"
            },
            "count": {
                "type": "number",
                "label": "Number of Comments",
                "default": "5"
            }
        }
    },
    "output": {
        "template": "widget.tpl",
        "providers": {
            "comments": {
                "provider": "CommentModel.getRecentApproved",
                "params": {
                    "limit": "count"
                }
            }
        }
    }
}