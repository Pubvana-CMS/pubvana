{
    "name": "Author Bio",
    "bundled": true,
    "free": false,
    "description": "Displays the post author's profile card on single post pages.",
    "version": "2.0.5",
    "min_pubvana_version": "2.2.3",
    "max_pubvana_version": "2.3.5",
    "update_url": "https://pubvana.net/api/dstore/v1/update/check",
    "support_url": "https://pubvana.net/contact",
    "items_url": "",
    "item_url": "",
    "categories_url": "",
    "categories_all_url": "",
    "category_url": "",
    "featured_url": "",
    "license_validate_url": "",
    "license_check_url": "",
    "update_check_url": "",
    "download_url": "",
    "store_url": "",
    "author": "Pubvana Team",
    "author_url": "https://pubvana.net",
    "admin": {
        "notice": "No configuration needed. This widget automatically displays the current post author's profile. Set up profiles in Admin \u2192 Users \u2192 Profile tab.",
        "options": {}
    },
    "output": {
        "template": "widget.tpl",
        "providers": {
            "profile": {
                "provider": "AuthorProfileModel.getForPost",
                "params": {
                    "postId": "@current_post_id"
                }
            }
        }
    }
}