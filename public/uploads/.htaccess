# Uploaded files are served, never executed.
#
# Media already validates the extension and MIME, so a .php cannot be stored
# today. This is the Apache side of the "never execute" guarantee, so a stray
# executable file cannot run if one ever lands here. The nginx equivalent is
# in nginx.conf.sample.
#
# Every directive is wrapped so an Apache without the module (or with
# AllowOverride restrictions) does not answer 500 for the whole directory.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht
    AddType text/plain .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht
</IfModule>
