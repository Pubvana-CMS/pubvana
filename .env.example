APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pubvana
DB_USER=root
DB_PASS=

SITE_NAME=Pubvana
SITE_URL=http://localhost:8080
ADMIN_EMAIL=admin@example.com

# Force HTTPS regardless of APP_ENV (production auto-forces otherwise)
# FORCE_HTTPS=true

# Session encryption key - 64 hex chars (required on web requests)
# Generate: php -r 'echo bin2hex(random_bytes(32));'
SESSION_ENCRYPTION_KEY=
