{
    "display_name": "Default",
    "description": "Pubvana's free default theme built on Bootswatch Flatly (Bootstrap 5). See Tools -> Marketplace -> Catalog for more options",
    "category": "presentation",
    "author": "pubvana",
    "type": "theme",
    "pubver_min": "3.0.0",
    "pubver_max": "",
    "slug": "default",
    "icon": "icon.svg",
    "semver": "1.4.31",
    "provides": {
        "options": {
            "layout": {
                "label": "Layout",
                "type": "group",
                "fields": {
                    "sidebar_location": {
                        "type": "select",
                        "label": "Sidebar Location",
                        "default": "sidebar-right",
                        "choices": {
                            "sidebar-right": "Sidebar Right",
                            "sidebar-left": "Sidebar Left"
                        }
                    },
                    "show_sidebar_on": {
                        "type": "select",
                        "label": "Show Sidebar On",
                        "default": "not_home",
                        "choices": {
                            "all": "All Pages",
                            "not_home": "All Pages Except Home",
                            "home": "Home Only",
                            "none": "None"
                        }
                    }
                }
            },
            "breadcrumbs": {
                "label": "Breadcrumbs",
                "type": "group",
                "fields": {
                    "enabled": {
                        "type": "toggle",
                        "label": "Show Breadcrumbs",
                        "default": "1"
                    }
                }
            },
            "hero": {
                "label": "Hero Section",
                "type": "group",
                "fields": {
                    "show": {
                        "type": "toggle",
                        "label": "Show Hero",
                        "default": "0"
                    },
                    "background": {
                        "type": "media",
                        "label": "Background Image"
                    },
                    "title": {
                        "type": "input",
                        "label": "Title"
                    }
                }
            },
            "footer_bottom": {
                "label": "Footer Bottom",
                "type": "group",
                "fields": {
                    "enabled": {
                        "type": "toggle",
                        "label": "Footer Bottom",
                        "default": "1"
                    },
                    "copyright": {
                        "type": "input",
                        "label": "Footer Text"
                    }
                }
            }
        },
        "regions": [
            {
                "id": "sidebar",
                "label": "Sidebar",
                "description": "Sidebar blocks, shown on pages per the Show Sidebar On layout option",
                "fallback": "after-content"
            },
            {
                "id": "footer-col-1",
                "label": "Footer Column 1",
                "description": "First footer column",
                "fallback": "footer"
            },
            {
                "id": "footer-col-2",
                "label": "Footer Column 2",
                "description": "Second footer column",
                "fallback": "footer"
            },
            {
                "id": "footer-col-3",
                "label": "Footer Column 3",
                "description": "Third footer column",
                "fallback": "footer"
            }
        ]
    }
}