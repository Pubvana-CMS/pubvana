{
    "name": "Default",
    "version": "2.0.0",
    "author": "Pubvana",
    "author_url": "https://pubvana.net",
    "support_url": "https://pubvana.net/contact",
    "description": "Clean Bootstrap 5 theme.",
    "screenshot": "screenshot.png",
    "widget_areas": {
        "sidebar": "Main Sidebar",
        "footer-1": "Footer Column 1",
        "footer-2": "Footer Column 2",
        "footer-3": "Footer Column 3",
        "before-content": "Before Content"
    },
    "options": {
        "show_sidebar": {
            "type": "checkbox",
            "label": "Show Sidebar",
            "default": "1"
        },
        "footer_copyright": {
            "type": "text",
            "label": "Footer Copyright Text",
            "default": ""
        }
    },
    "widget_classes": {
        "cls_widget": "widget mb-4",
        "cls_title": "h6 fw-bold mb-3 pb-2 border-bottom",
        "cls_list": "list-group list-group-flush",
        "cls_list_item": "list-group-item d-flex justify-content-between align-items-center",
        "cls_link": "text-decoration-none",
        "cls_badge": "badge bg-secondary rounded-pill",
        "cls_meta": "text-muted small",
        "cls_empty": "text-muted fst-italic",
        "cls_content": "mb-2",
        "cls_form": "d-flex gap-2",
        "cls_input": "form-control form-control-sm",
        "cls_button": "btn btn-sm btn-primary",
        "cls_tags": "d-flex flex-wrap gap-1",
        "cls_tag": "badge bg-light text-decoration-none",
        "cls_card": "d-flex gap-3 p-3 bg-light rounded",
        "cls_card_image": "rounded-circle",
        "cls_card_body": "flex-grow-1",
        "cls_card_title": "fw-bold",
        "cls_card_text": "text-muted small",
        "cls_thumbnail": "rounded float-start me-3",
        "cls_social_links": "d-flex gap-3",
        "cls_social_link": "text-muted text-decoration-none fs-5",
        "cls_toc_nav": "small",
        "cls_toc_list": "list-unstyled",
        "cls_toc_item": "py-1",
        "cls_toc_link": "text-decoration-none",
        "cls_fade": "position-relative",
        "cls_cta": "text-center p-4 bg-light rounded",
        "cls_icon": "fs-1 text-muted mb-3",
        "cls_paywall_title": "h5 fw-bold",
        "cls_message": "text-muted mb-3",
        "cls_btn_primary": "btn btn-primary",
        "cls_btn_secondary": "btn btn-outline-primary"
    }
}
