# Disable directory browsing
Options -Indexes

# Defense in depth when mod_rewrite is off: block sensitive files directly.
# These work without rewrite and cover the repo-root-served fallback.
# mod_alias RedirectMatch covers directories even with rewrite disabled.
<IfModule mod_alias.c>
    RedirectMatch 403 ^/(\.git|\.env|\.htaccess)(/|$)
    RedirectMatch 403 ^/(app|vendor|writable|plugins|themes|tests|node_modules)(/|$)
    RedirectMatch 403 ^/(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|psalm.*|phpstan.*|runway|cron|releases\.json|pubvana\.json|\.migrations_installed)(/|$)
</IfModule>
<FilesMatch "^(\.env|\.htaccess|\.gitignore|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|psalm.*|phpstan.*|releases\.json|pubvana\.json|\.migrations_installed|runway|cron)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Block dotfiles (.env, .git, .htaccess) first, except ACME challenges
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^\. - [F,L]

    # Block sensitive files
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|psalm.*|phpstan.*|runway|cron|releases\.json|pubvana\.json|\.migrations_installed) - [F,L]

    # Deny access to sensitive directories
    RewriteRule ^(app|vendor|writable|plugins|themes|tests|node_modules)(/|$) - [F,L]

    # Redirect trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve static files from public/
    RewriteCond %{DOCUMENT_ROOT}/public/%{REQUEST_URI} -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Front controller - "/" and every non-file path. ("/" is a real
    # directory, so the !-d conditions below would never match it.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d [OR]
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^(.*)$ public/index.php [L,QSA]

    # Ensure Authorization header is passed along
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 public/index.php
</IfModule>

# Disable server signature
ServerSignature Off
