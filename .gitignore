/vendor/

# testing
.phpunit.cache/

# Environment and local config
.env
.env.local

# Runtime / install markers
.migrations_installed

# Writable application data
/writable/cache/*
!/writable/cache/.gitkeep
/writable/logs/*
!/writable/logs/.gitkeep
/writable/backups/*
!/writable/backups/.gitkeep
/writable/updates/*
!/writable/updates/.gitkeep
/writable/store/*
!/writable/store/.gitkeep
/writable/tmp/*
!/writable/tmp/.gitkeep
/writable/trust/*
!/writable/trust/.gitkeep

# Public uploads (site media/content)
/public/uploads/*
!/public/uploads/.gitkeep

# Node.js
/node_modules/
node_modules
