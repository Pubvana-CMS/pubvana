# Environment
.env
.env.*
!.env.example

# Composer
/vendor/

# CI4 writable directory
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/tmp/*
/writable/uploads/*
/writable/backups/*
/writable/updates/*
!/writable/cache/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/tmp/.gitkeep
!/writable/uploads/.gitkeep
!/writable/backups/.gitkeep
!/writable/updates/.gitkeep

# Node (if ever used)
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/
CLAUDE.md

# Theme asset symlinks (recreated on deploy)
/public/themes/*
!/public/themes/default/

# Generated OG images (built at runtime by OgImageService)
/public/og/

# Premium themes (distributed via pubvana.net store)
themes/businessBlue/
themes/cyborg/
themes/darkly/
themes/ember/
themes/flatly/
themes/lux/
themes/sandstone/
themes/pvdark/
themes/slate/
themes/testbad/
themes/ember.zip

# Plugins (installed locally, not part of core)
plugins/*
!plugins/.gitkeep

# Local-only widgets
widgets/DstoreCart/
public/writable/

# PHPUnit / build output
/tests/
/build/
.worktrees/

# Release checklist (local only)
release-checklist.md

# Local notes and scripts
MULTI-SITE-NOTES.md
new_languages.sql

# Docs (replaced by PvDocs plugin)
docs/
