parameters:
    level: 3
    paths:
        - app/
    excludePaths:
        - app/Views
        - app/config
    scanDirectories:
        - vendor/
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#Call to an undefined method#'
        -
            message: '#Access to an undefined property#'
        -
            message: '#should return array.*Pubvana#'
        -
            message: '#Constant PROJECT_ROOT not found#'
        -
            message: '#on left side of \?\? always exists and is not nullable#'
        -
            message: '#Undefined variable: \$ds#'
        -
            message: '#Anonymous function has an unused use#'
        -
            message: '#File ends with a trailing whitespace#'
